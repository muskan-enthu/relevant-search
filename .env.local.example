# ---------------------------------------------------------------
# Copy this file to .env.local and fill in your keys.
# ---------------------------------------------------------------

# REQUIRED - the search provider. Free key at https://tavily.com
# 1000 searches/month. Each app search costs 4 (one per channel),
# so that is roughly 250 searches per month.
TAVILY_API_KEY=

# OPTIONAL - powers the suggestions dropdown as you type.
# Free key at https://console.groq.com
# Without it the app works exactly the same, just with no suggestions.
GROQ_API_KEY=

# OPTIONAL - override the Groq model. Run `npm run models` to list
# what your key can actually access; the free lineup changes.
# GROQ_MODEL=openai/gpt-oss-120b
