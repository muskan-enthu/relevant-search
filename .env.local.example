# ---------------------------------------------------------------
# Everything here is OPTIONAL. Hacker News and GitHub both work
# with no credentials at all.
# ---------------------------------------------------------------

# Enables the YouTube channel. Free key, no billing account needed:
# console.cloud.google.com -> enable "YouTube Data API v3" -> create API key
# Quota: 100 searches/day.
YOUTUBE_API_KEY=

# Raises GitHub from 10 to 30 searches/min, and stops you sharing an IP
# rate limit with strangers once deployed. Create at
# github.com/settings/tokens with NO scopes ticked.
GITHUB_TOKEN=

# Powers the suggestions dropdown as you type. Free key at console.groq.com
# Without it the app works the same, just with no suggestions.
GROQ_API_KEY=
